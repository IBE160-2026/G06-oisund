server {
    listen 8080 default_server;
    server_name _;
    access_log off;
    return 444;
}
server {
    listen 8080;
    server_name ${TABLET_HOST};
    absolute_redirect off;
    root /usr/share/nginx/html;
    access_log off;
    server_tokens off;
    client_max_body_size 12m;
    auth_request /_access_verify;
    add_header Cache-Control "no-store" always;
    add_header Pragma "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;

    location = / { try_files /index.html =404; }
    location = /private { try_files /index.html =404; }
    location = /_access_verify {
        internal;
        auth_request off;
        proxy_pass http://access-gate:8081/verify;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie "";
        proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_next_upstream off;
    }
    location = /private-api { return 404; }
    location /assets/ { try_files $uri =404; }
    location /private-api/ {
        proxy_pass http://private-api:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host ${TABLET_HOST};
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_redirect off;
        proxy_next_upstream off;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 65s;
        proxy_hide_header Cache-Control;
        proxy_hide_header Pragma;
    }
    location / { return 404; }
}
