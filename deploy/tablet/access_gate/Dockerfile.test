# Local test image only; the production gate intentionally has no pip.
ARG GATE_IMAGE=ibe160-tablet-access-gate:11-6
FROM python:3.13.18-slim-trixie@sha256:76baad6037690d6e8c4397fbcaef17bca6f19eecef822b708fe8fa3417d30bb5 AS test_dependencies
RUN pip install --no-cache-dir --target /test-dependencies pytest==9.0.3 iniconfig==2.3.1 packaging==26.3 pluggy==1.7.0 Pygments==2.21.0
FROM ${GATE_IMAGE}
COPY --from=test_dependencies /test-dependencies/ /usr/local/lib/python3.13/site-packages/
USER 10001:10001
